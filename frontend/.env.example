# ReportSaathi Frontend Environment Variables Template
# Copy this file to .env and configure your values.
# NEVER commit real secret values to version control.

# Backend API Base URL
# Local development: http://localhost:8000
# Production: https://your-report-saathi-api.onrender.com
VITE_API_URL=http://localhost:8000

# Supabase Credentials (Optional - leave empty for Demo Mode)
# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
