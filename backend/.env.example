# ReportSaathi Backend Environment Variables Template
# Copy this file to .env and configure your values.
# NEVER commit real secret values to version control.

PORT=8000
ENVIRONMENT=development

# Google Gemini API
# Get an API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Tesseract OCR Executable Path
# Windows default: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux / Docker default: /usr/bin/tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Maximum Upload File Size in Megabytes
MAX_FILE_SIZE_MB=15

# Supabase Credentials (Optional - leave empty for Demo Mode)
# Project Settings -> API -> Project URL & anon/service_role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key_here

# Telegram Bot Token (Optional - leave empty if not using Telegram bot)
# Obtain via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
